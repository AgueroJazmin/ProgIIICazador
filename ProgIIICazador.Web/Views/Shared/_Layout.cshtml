<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Cazador de Ofertas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Cazador de Ofertas</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Ofertas" asp-action="Index">Ofertas</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Reportes" asp-action="Create">Reportar un problema</a></li>
                    @if (User.Identity?.IsAuthenticated == true) { <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Administración</a></li> }
                    else { <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Login">Administración</a></li> }
                </ul>
            </div>
        </div>
    </nav>
</header>
<main class="container py-4">
    @RenderBody()
</main>
<footer class="border-top py-3 text-muted">
    <div class="container small">Cazador de Ofertas · Información centralizada desde publicaciones oficiales. Verificá siempre las condiciones en la fuente original.</div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>