@model Oferta
@{
    ViewData["Title"] = Model.Titulo;
}
<a asp-action="Index" class="link-secondary text-decoration-none">← Volver a las ofertas</a>
<article class="card mt-3">
    <div class="card-body p-4">
        <span class="badge text-bg-secondary mb-2">@Model.Empresa?.Nombre</span>
        <h1 class="h2">@Model.Titulo</h1>
        <p class="lead">@Model.Beneficio</p>
        <hr />
        <h2 class="h5">Descripción</h2><p>@Model.Descripcion</p>
        <h2 class="h5">Condiciones</h2><p>@(string.IsNullOrWhiteSpace(Model.Condiciones) ? "Consultar condiciones en la publicación original." : Model.Condiciones)</p>
        <p><strong>Vigencia:</strong> @(Model.VigenciaDesde?.ToString("dd/MM/yyyy") ?? "No informada") al @(Model.VigenciaHasta?.ToString("dd/MM/yyyy") ?? "No informada")</p>
        <a class="btn btn-dark" href="@Model.UrlFuente" target="_blank" rel="noopener noreferrer">Consultar publicación original</a>
    </div>
</article>