@{
    ViewData["Title"] = "Inicio";
}
<section class="p-5 mb-4 rounded-4 hero">
    <div class="col-lg-8">
        <span class="badge text-bg-warning mb-3">Promociones centralizadas</span>
        <h1 class="display-5 fw-bold">Encontrá las ofertas oficiales en un solo lugar.</h1>
        <p class="lead">Consultá beneficios publicados por McDonald's, Burger King y Mostaza, con acceso directo a la información original y sus condiciones.</p>
        <a class="btn btn-dark btn-lg" asp-controller="Ofertas" asp-action="Index">Ver ofertas</a>
    </div>
</section>
<div class="row g-3">
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h2 class="h5">Información organizada</h2><p class="mb-0">Beneficios, condiciones y vigencias reunidos en fichas claras.</p></div></div></div>
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h2 class="h5">Fuentes originales</h2><p class="mb-0">Cada oferta publicada conserva el enlace a su fuente para verificar los detalles.</p></div></div></div>
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h2 class="h5">Información revisable</h2><p class="mb-0">Podés reportar ofertas vencidas o datos que parezcan incorrectos.</p></div></div></div>
</div>