@model LoginViewModel
@{ ViewData["Title"] = "Acceso administrador"; }
<div class="row justify-content-center"><div class="col-md-5">
    <h1 class="h3 mb-3">Acceso administrativo</h1>
    <p class="text-muted">Ingresá con las credenciales configuradas por el responsable del sistema.</p>
    <form asp-action="Login" method="post" class="card card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <label asp-for="Usuario" class="form-label">Usuario</label><input asp-for="Usuario" class="form-control mb-3" autocomplete="username" />
        <label asp-for="Contrasena" class="form-label">Contraseña</label><input asp-for="Contrasena" class="form-control mb-3" autocomplete="current-password" />
        <button class="btn btn-dark" type="submit">Ingresar</button>
    </form>
</div></div>